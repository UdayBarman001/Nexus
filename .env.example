# ==============================================================================
# Nexus Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# Generate a 256-bit base64 secret using: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=Nexusdb
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
DB_URL=jdbc:postgresql://localhost:5432/Nexusdb
DDL_AUTO=validate

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# ------------------------------------------------------------------------------
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=nexus_admin
MINIO_SECRET_KEY=change_me_to_a_secure_minio_secret
MINIO_BUCKET=nexus-documents

# ------------------------------------------------------------------------------
# Ollama LLM & Embeddings Configuration
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# RAG Tuning Parameters
# ------------------------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
RAG_HISTORY_WINDOW=6

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Demo Account Seeding (Local Development Only)
# ------------------------------------------------------------------------------
DEMO_ACCOUNTS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Password123
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=Password123

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
