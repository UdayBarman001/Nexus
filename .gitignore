# ==============================================================================
# Git Ignore for Nexus Monorepo
# ==============================================================================

# Environment variables & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Build outputs
target/
**/target/
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
*.class
*.jar
*.war
*.tsbuildinfo
**/*.tsbuildinfo

# Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# IDEs and Editors
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
**/*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Logs
*.log
**/*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Storage & Local Data Volumes
nexus-pgdata/
nexus-ollama/
nexus-minio/
data/
minio-data/
uploads/
**/uploads/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini
